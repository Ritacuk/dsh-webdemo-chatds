{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@dsh-chat/shared": ["../chat-shared/src/index.ts"],
      "@dsh-chat/shared/*": ["../chat-shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tsdown.config.ts", "../chat-shared/src/**/*.ts", "../chat-sidecar/src/**/*.ts"]
}
