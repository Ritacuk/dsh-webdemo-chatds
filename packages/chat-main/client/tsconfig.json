{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@dsh-chat/shared": ["../chat-shared/src/index.ts"],
      "@dsh-chat/shared/*": ["../chat-shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "rspack.config.ts", "../chat-shared/src/**/*.ts"]
}
